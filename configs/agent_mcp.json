{
  "mcpServers": {
    "Analysis": {
      "command": "python",
      "args": ["tools/Analysis.py", "--temp_dir", "tmp/out"]
    },
    "Index": {
      "command": "python",
      "args": ["tools/Index.py", "--temp_dir", "tmp/out"]
    },
    "Inversion": {
      "command": "python",
      "args": ["tools/Inversion.py", "--temp_dir", "tmp/out"]
    },
    "Perception": {
      "command": "python",
      "args": ["tools/Perception.py", "--temp_dir", "tmp/out"],
      "env": {
        "REMOTECLIP_API_URL": "http://127.0.0.1:5556/classify",
        "REMOTECLIP_HEALTH_URL": "http://127.0.0.1:5556/health"
      }
    },
    "Statistics": {
      "command": "python",
      "args": ["tools/Statistics.py", "--temp_dir", "tmp/out"]
    }
  }
}
